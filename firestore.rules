rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- THANKSGIVING APP (No login required for family guests) ---
    // 1. Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0 
                    && request.resource.data.name.size() <= 60;
      allow update, delete: if true;
    }

    // 2. Items
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.broughtBy is string
                    && request.resource.data.broughtBy.size() > 0
                    && request.resource.data.categoryId is string
                    && request.resource.data.ownerId is string;
      allow update, delete: if true;
    }

    // 3. Wishlist Suggestions (Allows categoryId to be null or string for general ideas)
    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0 
                    && request.resource.data.name.size() <= 100;
      allow update, delete: if true;
    }

    // --- MULTI-STOPWATCH APP ---
    match /workspaces/{workspaceId} {
      allow read, write: if true;
    }

    // --- YOUR EXISTING APP RULES ---
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function memberPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
    }
    function isMember(groupId) {
      return signedIn() && exists(memberPath(groupId));
    }
    function isOwner(groupId) {
      return isMember(groupId) && get(memberPath(groupId)).data.role == 'owner';
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid);
      match /groupIds/{groupId} {
        allow read, write: if isSelf(uid);
      }
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'joinCode', 'ownerId', 'categories', 'createdAt']);
      allow read: if signedIn();
      allow update: if isOwner(groupId);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(groupId) || isSelf(uid);
        allow create: if signedIn() && isSelf(uid)
          && (request.resource.data.role == 'member'
            || (request.resource.data.role == 'owner'
              && request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId));
        allow update, delete: if false;
      }

      match /items/{itemId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isMember(groupId)
          && (resource.data.createdBy == request.auth.uid || isOwner(groupId));
      }

      match /events/{eventId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going']);
        allow delete: if isOwner(groupId) || resource.data.createdBy == request.auth.uid;
      }
    }
  }
}
